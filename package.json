{
  "name": "google-drive-vault-sync",
  "version": "0.3.2",
  "description": "Safety-first Google Drive synchronization for Obsidian on Windows and iPhone",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "test": "vitest run",
    "deploy:test": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-test.ps1"
  },
  "keywords": [
    "obsidian",
    "google-drive",
    "sync"
  ],
  "author": "harine",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "26.1.2",
    "builtin-modules": "5.3.0",
    "esbuild": "0.28.1",
    "obsidian": "1.13.1",
    "tslib": "2.8.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
